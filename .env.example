# ============================================================
# Enphase C&I Fleet Health Intelligence Platform
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# ── Frontend (Vite) ──────────────────────────────────────────
# Controls which data provider the React app uses.
# 'backend' = live data via Express API (production default)
# 'mock'    = representative mock data (no server needed)
VITE_DATA_PROVIDER=backend

# ── Backend (Express server) — NEVER prefix with VITE_ ──────
# These stay on the server only. They are NOT bundled into the browser JS.

# Incorta base URL
INCORTA_BASE_URL=https://enphase-1.cloud2.incorta.com

# Incorta tenant name (appears in API path)
INCORTA_TENANT=enphase

# Personal Access Token — KEEP THIS SECRET
# Rotate immediately if it ever appears in source control or browser DevTools
INCORTA_PAT=

# Fleet/Site Business View — C&I Severity & Cases dashboard
INCORTA_DASHBOARD_ID=ee817bdb-9b6a-4135-97d2-52ac36e23c63
INCORTA_INSIGHT_ID=

# SFDC Case Business View — leave empty if not yet available
# When configured, enables live Case Intelligence, Action Queue, and Case Coverage
INCORTA_CASE_DASHBOARD_ID=
INCORTA_CASE_INSIGHT_ID=

# Express server port (default: 3001)
API_PORT=3001
